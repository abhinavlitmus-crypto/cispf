{
  "info": {
    "name": "Sa-dhan Assessment Module",
    "description": "End-to-end flow: admin login -> create a scored FormBuilder form -> assign it as an Assessment to a course/module/lesson -> app user login -> fetch + submit the assessment. Fill in {{courseId}} (and optionally {{moduleId}}/{{lessonId}}) from your own DB before running '3. Admin Assessment'.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "baseUrl", "value": "http://localhost:4500" },
    { "key": "adminToken", "value": "" },
    { "key": "userToken", "value": "" },
    { "key": "formId", "value": "" },
    { "key": "assignmentId", "value": "" },
    { "key": "courseId", "value": "" },
    { "key": "moduleId", "value": "" },
    { "key": "lessonId", "value": "" }
  ],
  "item": [
    {
      "name": "1. Admin Auth",
      "item": [
        {
          "name": "Admin Login",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "const res = pm.response.json();",
                  "if (res?.data?.accessToken) {",
                  "  pm.collectionVariables.set('adminToken', res.data.accessToken);",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"code\": \"test@gmail.com\",\n  \"password\": \"test\"\n}"
            },
            "url": { "raw": "{{baseUrl}}/admin/login", "host": ["{{baseUrl}}"], "path": ["admin", "login"] },
            "description": "Default seeded admin from GET /admin/init-admin (email test@gmail.com / password test). Response.data.accessToken is captured into {{adminToken}} automatically."
          }
        }
      ]
    },
    {
      "name": "2. Form Builder",
      "item": [
        {
          "name": "Save Scored Form",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "const res = pm.response.json();",
                  "if (res?.data?._id) {",
                  "  pm.collectionVariables.set('formId', res.data._id);",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{adminToken}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Module 1 Assessment\",\n  \"details\": {\n    \"sections\": [\n      {\n        \"id\": \"sec_1\",\n        \"title\": \"GENERAL KNOWLEDGE\",\n        \"description\": \"\",\n        \"fields\": [\n          {\n            \"id\": \"field_1\",\n            \"type\": \"select_single\",\n            \"label\": \"WHAT IS THE CAPITAL OF FRANCE?\",\n            \"options\": [\"PARIS\", \"LONDON\", \"BERLIN\"],\n            \"correctAnswer\": \"PARIS\",\n            \"points\": 1\n          },\n          {\n            \"id\": \"field_2\",\n            \"type\": \"select_multiple\",\n            \"label\": \"WHICH OF THESE ARE PRIME NUMBERS?\",\n            \"options\": [\"2\", \"3\", \"4\"],\n            \"correctAnswers\": [\"2\", \"3\"],\n            \"points\": 2\n          }\n        ]\n      }\n    ]\n  }\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/admin/form-builder/save",
              "host": ["{{baseUrl}}"],
              "path": ["admin", "form-builder", "save"]
            },
            "description": "field.id values (field_1/field_2) must match the keys used in the 'answers' object when submitting from the app side. In the real admin UI these ids are auto-generated by FormBuilder.js's genId()."
          }
        },
        {
          "name": "List Forms",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{adminToken}}" }],
            "url": {
              "raw": "{{baseUrl}}/admin/form-builder/list?isAll=true",
              "host": ["{{baseUrl}}"],
              "path": ["admin", "form-builder", "list"],
              "query": [{ "key": "isAll", "value": "true" }]
            }
          }
        }
      ]
    },
    {
      "name": "3. Admin Assessment",
      "item": [
        {
          "name": "List Courses (to pick courseId/moduleId/lessonId)",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{adminToken}}" }],
            "url": {
              "raw": "{{baseUrl}}/admin/course/list?isAll=true",
              "host": ["{{baseUrl}}"],
              "path": ["admin", "course", "list"],
              "query": [{ "key": "isAll", "value": "true" }]
            },
            "description": "Copy a course _id (and optionally a modules[]._id / modules[].lessons[]._id) into the {{courseId}}/{{moduleId}}/{{lessonId}} collection variables before running the next request."
          }
        },
        {
          "name": "Save Assignment (Assign Form to Course)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "const res = pm.response.json();",
                  "if (res?.data?._id) {",
                  "  pm.collectionVariables.set('assignmentId', res.data._id);",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{adminToken}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"formId\": \"{{formId}}\",\n  \"courseId\": \"{{courseId}}\",\n  \"targetType\": \"course\",\n  \"passPercentage\": 40,\n  \"isMandatory\": true\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/admin/assessment/save",
              "host": ["{{baseUrl}}"],
              "path": ["admin", "assessment", "save"]
            },
            "description": "Set targetType to 'module' or 'lesson' and include moduleId/lessonId to scope narrower instead of the whole course."
          }
        },
        {
          "name": "List Assignments",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{adminToken}}" }],
            "url": {
              "raw": "{{baseUrl}}/admin/assessment/list",
              "host": ["{{baseUrl}}"],
              "path": ["admin", "assessment", "list"]
            }
          }
        },
        {
          "name": "Assignment Details",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{adminToken}}" }],
            "url": {
              "raw": "{{baseUrl}}/admin/assessment/details/{{assignmentId}}",
              "host": ["{{baseUrl}}"],
              "path": ["admin", "assessment", "details", "{{assignmentId}}"]
            }
          }
        },
        {
          "name": "Delete Assignment",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{adminToken}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"ids\": \"{{assignmentId}}\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/admin/assessment/delete",
              "host": ["{{baseUrl}}"],
              "path": ["admin", "assessment", "delete"]
            }
          }
        }
      ]
    },
    {
      "name": "4. App Auth",
      "item": [
        {
          "name": "App User Login (OTP)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "const res = pm.response.json();",
                  "if (res?.data?.accessToken) {",
                  "  pm.collectionVariables.set('userToken', res.data.accessToken);",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"phoneNumber\": \"9999999998\",\n  \"otp\": \"123456\"\n}"
            },
            "url": { "raw": "{{baseUrl}}/app/user/login", "host": ["{{baseUrl}}"], "path": ["app", "user", "login"] },
            "description": "OTP is hardcoded to 123456 in userService.login for local/dev testing. A user with this phoneNumber is auto-created if one doesn't exist."
          }
        }
      ]
    },
    {
      "name": "5. App Assessment",
      "item": [
        {
          "name": "List Assessments For Course",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{userToken}}" }],
            "url": {
              "raw": "{{baseUrl}}/app/assessment/list?courseId={{courseId}}",
              "host": ["{{baseUrl}}"],
              "path": ["app", "assessment", "list"],
              "query": [{ "key": "courseId", "value": "{{courseId}}" }]
            },
            "description": "Add &moduleId={{moduleId}} / &lessonId={{lessonId}} to scope to a specific module/lesson instead."
          }
        },
        {
          "name": "Assessment Details (Form, No Answer Key)",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{userToken}}" }],
            "url": {
              "raw": "{{baseUrl}}/app/assessment/details/{{assignmentId}}",
              "host": ["{{baseUrl}}"],
              "path": ["app", "assessment", "details", "{{assignmentId}}"]
            },
            "description": "Verify the response's form.details.sections[].fields[] never contain correctAnswer/correctAnswers/points."
          }
        },
        {
          "name": "Submit Assessment",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{userToken}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"assignmentId\": \"{{assignmentId}}\",\n  \"answers\": {\n    \"field_1\": \"PARIS\",\n    \"field_2\": [\"2\", \"3\"]\n  }\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/app/assessment/submit",
              "host": ["{{baseUrl}}"],
              "path": ["app", "assessment", "submit"]
            },
            "description": "Keys in 'answers' must match the field.id values from the form (see '2. Form Builder > Save Scored Form'). Response includes score/maxScore/percentage/isPassed."
          }
        },
        {
          "name": "My Submissions",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{userToken}}" }],
            "url": {
              "raw": "{{baseUrl}}/app/assessment/submissions/{{assignmentId}}",
              "host": ["{{baseUrl}}"],
              "path": ["app", "assessment", "submissions", "{{assignmentId}}"]
            }
          }
        }
      ]
    }
  ]
}
